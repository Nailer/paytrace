# Local use needs no secrets. Hosted use requires all four values below.
# Generate credentials with: node scripts/setup-hosting.mjs https://your-hostname
# PAYTRACE_PUBLIC_ORIGIN=https://your-hostname
# PAYTRACE_PASSWORD_HASH=salt:scrypt-hash
# PAYTRACE_SESSION_SECRET=at-least-32-random-characters
# PAYTRACE_DB_PATH=/data/paytrace.sqlite

# Vercel uses a remote database instead of PAYTRACE_DB_PATH.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=server-only-database-token
